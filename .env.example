NODE_ENV=development
PORT=4000

# Pooled connection, used by the server
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=verify-full"
# Direct connection, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Base64 of a PKCS#8 PEM P-256 private key:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | base64 -w0
JWT_PRIVATE_KEY_BASE64=""
JWT_KEY_ID="k1"

# At least 32 random characters: openssl rand -base64 32
OTP_PEPPER=""

# How codes reach students: console or authentica.
# "console" prints them to the backend's console, and the server refuses to start with it in production.
OTP_DELIVERY="console"
# For authentica: the API key from the application's page at https://portal.authentica.sa
# AUTHENTICA_API_KEY=""
# sms or whatsapp
# AUTHENTICA_METHOD="sms"
# The message template from the portal. Authentica uses template 1 when unset.
# AUTHENTICA_TEMPLATE_ID=""
# App Review: one number that signs in with a fixed 4-digit code and gets no SMS. Set both or neither.
# REVIEW_PHONE="+966500000000"
# REVIEW_CODE=""

# Address or range of the reverse proxy, or "false" when there is none.
TRUST_PROXY="false"

# How staff recovery links are sent: console (development only) or smtp.
MAIL_DELIVERY="console"
# SMTP_URL="smtps://user:pass@mail.example.com"
# MAIL_FROM="Qimam <no-reply@example.com>"

# Comma-separated. The dashboard origins allowed to call the API from a browser.
ADMIN_ORIGINS="http://localhost:3000"

# Base64 of 32 random bytes, which encrypts staff authenticator secrets: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=""

# Voice sessions. Optional: comma-separated STUN servers, with a public one by default.
# STUN_URLS="stun:stun.l.google.com:19302"
# Optional here, needed in production: a TURN server (such as coturn) relays calls on networks that block direct paths.
# TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
# TURN_SECRET=""

# Optional. Only when "enhanced push security" is on for the Expo project.
# EXPO_ACCESS_TOKEN=

# Where uploaded files are kept (badges/, certificates/backgrounds/, recordings/). Relative to where the server starts.
UPLOADS_DIR=uploads

# iPhone notifications straight to Apple (no Expo): the team's APNs key from developer.apple.com > Keys.
# Set all three or none. APNS_PRIVATE_KEY_BASE64 is the .p8 file in base64: base64 -i AuthKey_XXXX.p8
# APNS_KEY_ID=""
# APNS_TEAM_ID=""
# APNS_PRIVATE_KEY_BASE64=""
# APNS_TOPIC="com.qimam.quran"
